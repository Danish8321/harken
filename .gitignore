# Build output
bin/
obj/

# SQLite databases
*.db

# Local appsettings
appsettings.*.json

# User-specific files
*.user
src/Harken.Api/recordings/
.vs/

# Claude Code harness state
.claude/scheduled_tasks.lock

# Scratch binaries (test artifacts, not source). Corpora and models are downloaded
# on demand and can be tens of megabytes; ES2002a.Mix-Headset.wav was tracked at 39
# MB before this rule existed. The 90-second excerpt a test actually asserts against
# lives in app/src/test/resources instead, where its size is the reason it is short.
.scratch/*.bin
.scratch/*.wav

# Signing key config. keystore.properties.example is committed; the real one names a
# keystore path and carries its passwords, and never is.
keystore.properties
