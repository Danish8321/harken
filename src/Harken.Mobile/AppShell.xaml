<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Harken.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Harken.Mobile"
    xmlns:pages="clr-namespace:Harken.Mobile.Pages"
    Title="Harken.Mobile">

    <ShellContent
        Title="Capture"
        ContentTemplate="{DataTemplate pages:CapturePage}"
        Route="CapturePage" />

    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate pages:SettingsPage}"
        Route="SettingsPage" />

</Shell>
