<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Harken.Mobile.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sessions">

    <Grid Padding="20" RowSpacing="12" RowDefinitions="Auto,Auto,*,Auto,*">

        <HorizontalStackLayout Grid.Row="0" Spacing="12">
            <Button x:Name="RefreshButton" Text="Refresh" Clicked="OnRefreshClicked" />
            <Button x:Name="SummarizeButton" Text="Summarize" Clicked="OnSummarizeClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel" Grid.Row="1" Text="Idle" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout>
                <!-- Recording moves here in slice 05: capture to a local file, then upload. -->
                <Label
                    Text="Recording is not available in this build. Sessions recorded elsewhere can be read and summarized here."
                    LineBreakMode="WordWrap"
                    FontSize="12" />
                <CollectionView x:Name="SessionsView" SelectionMode="Single" SelectionChanged="OnSessionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Padding="0,8" Text="{Binding Display}" LineBreakMode="TailTruncation" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="3" Text="Summary" FontAttributes="Bold" />

        <ScrollView Grid.Row="4">
            <Editor x:Name="SummaryEditor" IsReadOnly="True" AutoSize="TextChanges" />
        </ScrollView>

    </Grid>

</ContentPage>
