<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Harken.Mobile.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sessions">

    <Grid Padding="20" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,*,Auto,*,Auto,*">

        <HorizontalStackLayout Grid.Row="0" Spacing="12">
            <Button x:Name="RecordButton" Text="Record" Clicked="OnRecordClicked" />
            <Button x:Name="StopButton" Text="Stop" Clicked="OnStopClicked" IsEnabled="False" />
            <Label x:Name="ElapsedLabel" Text="00:00" VerticalOptions="Center" FontAttributes="Bold" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Button x:Name="RefreshButton" Text="Refresh" Clicked="OnRefreshClicked" />
            <Button x:Name="SummarizeButton" Text="Summarize" Clicked="OnSummarizeClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel" Grid.Row="2" Text="Idle" />

        <ScrollView Grid.Row="3">
            <VerticalStackLayout>
                <CollectionView x:Name="SessionsView" SelectionMode="Single" SelectionChanged="OnSessionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Padding="0,8" Text="{Binding Display}" LineBreakMode="TailTruncation" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="4" Text="Transcript" FontAttributes="Bold" />

        <ScrollView Grid.Row="5">
            <Editor x:Name="TranscriptEditor" IsReadOnly="True" AutoSize="TextChanges" />
        </ScrollView>

        <Label Grid.Row="6" Text="Summary" FontAttributes="Bold" />

        <ScrollView Grid.Row="7">
            <Editor x:Name="SummaryEditor" IsReadOnly="True" AutoSize="TextChanges" />
        </ScrollView>

    </Grid>

</ContentPage>
