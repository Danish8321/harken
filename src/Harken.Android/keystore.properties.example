# Copy to keystore.properties (gitignored) to produce a signed release build.
#
# Without this file assembleRelease still runs and still exercises R8 and resource
# shrinking — it just produces an unsigned APK. That keeps check.sh working on a machine
# that has no signing key, which is every machine except the one that publishes.
storeFile=/absolute/path/to/harken-release.jks
storePassword=
keyAlias=harken
keyPassword=
