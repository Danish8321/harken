<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer (Android 13+). Same geometry as ic_launcher_foreground, drawn in
  one flat colour that the system re-tints to the user's wallpaper palette — so it cannot
  reference the accent, and a second file is the only way to say that.

  This is also why the grille slits are cut out of the head with evenOdd rather than painted
  in the background colour: here there is no background colour to paint them in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The head, with the meter cut out of it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M43,38 a11,11 0 0 1 22,0 v12 a11,11 0 0 1 -22,0 z
                          M45.75,39.5 a1.5,1.5 0 0 1 3,0 v9 a1.5,1.5 0 0 1 -3,0 z
                          M50.25,35.5 a1.5,1.5 0 0 1 3,0 v17 a1.5,1.5 0 0 1 -3,0 z
                          M54.75,37.5 a1.5,1.5 0 0 1 3,0 v13 a1.5,1.5 0 0 1 -3,0 z
                          M59.25,41 a1.5,1.5 0 0 1 3,0 v6 a1.5,1.5 0 0 1 -3,0 z" />

    <!-- The cradle: the half-ring the head hangs in. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M70,52 A16,16 0 0 1 38,52" />

    <!-- The stem. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52.2,68 h3.6 v10 h-3.6 z" />

    <!-- The foot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44.7,78 h18.6 a1.7,1.7 0 0 1 0,3.4 h-18.6 a1.7,1.7 0 0 1 0,-3.4 z" />
</vector>
