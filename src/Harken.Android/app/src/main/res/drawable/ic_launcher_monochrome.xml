<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer (Android 13+). Same geometry as ic_launcher_foreground, drawn in
  one flat colour that the system re-tints to the user's wallpaper palette — so it cannot
  reference the accent, and a second file is the only way to say that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ticks — the quiet end of the meter. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,48 a3,3 0 0 1 6,0 v12 a3,3 0 0 1 -6,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M82,48 a3,3 0 0 1 6,0 v12 a3,3 0 0 1 -6,0 z" />

    <!-- Inner bars. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,40 a3,3 0 0 1 6,0 v28 a3,3 0 0 1 -6,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M70,40 a3,3 0 0 1 6,0 v28 a3,3 0 0 1 -6,0 z" />

    <!-- The centre bar is the microphone: capsule, stem, base. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45,35 a9,9 0 0 1 18,0 v16 a9,9 0 0 1 -18,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51,63 a3,3 0 0 1 6,0 v10 a3,3 0 0 1 -6,0 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,76 h12 a3,3 0 0 1 0,6 h-12 a3,3 0 0 1 0,-6 z" />
</vector>
