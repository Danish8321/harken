<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer (Android 13+). Same geometry as ic_launcher_foreground, drawn in
  one flat colour that the system re-tints to the user's wallpaper palette — so it cannot
  reference the accent, and a second file is the only way to say that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The capsule: the mic's head. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,40 a14,14 0 0 1 28,0 v18 a14,14 0 0 1 -28,0 z" />

    <!-- The stem: connects the head to the base. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,72 h12 v6 h-12 z" />

    <!-- The base: what the mic stands on. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,74 h36 a4,4 0 0 1 0,8 h-36 a4,4 0 0 1 0,-8 z" />
</vector>
