<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer (Android 13+). Same geometry as ic_launcher_foreground, drawn in
  one flat colour that the system re-tints to the user's wallpaper palette — so it cannot
  reference the accent, and a second file is the only way to say that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The capsule: the mic's head. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44.2,44.2 a9.8,9.8 0 0 1 19.6,0 v12.6 a9.8,9.8 0 0 1 -19.6,0 z" />

    <!-- The stem: connects the head to the base. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M49.8,66.6 h8.4 v4.2 h-8.4 z" />

    <!-- The base: what the mic stands on. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M41.4,68 h25.2 a2.8,2.8 0 0 1 0,5.6 h-25.2 a2.8,2.8 0 0 1 0,-5.6 z" />
</vector>
