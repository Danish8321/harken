<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a microphone whose grille is a level meter.

  v1 (ARC-001) drew a capsule/stem/base at 18dp wide inside a 68x56dp safe zone plus four
  tick shapes meant to read as a meter. On a real home screen the whole thing read as a
  faint grey smear. v2 enlarged three shapes to equal weight and stopped reading as a mic
  at all. v3 dropped the meter, kept one glyph, and filled the safe zone edge to edge. v4
  scaled v3 by 0.7 because v3 read as oversized once installed.

  All four argued about size. Size was never the fault. v4's stem is 8.4dp wide against a
  25.2dp base and starts 1.4dp above it, so the two merge into one shape: at launcher
  scale the silhouette is a lump with no microphone cue left in it — a bust, or a rubber
  stamp. Nothing in it separates the head from what it stands on.

  v5 fixes that with the part every one of the four was missing: a cradle. The arc under
  the head is what says "microphone" rather than "capsule", and it puts air around a stem
  that is now clear of the foot instead of buried in it. The grille slits then do double
  duty — they run vertical and vary in length (9, 12, 16, 20dp), so the thing a mic has on
  its face is also the level meter the Record screen draws. Below about 72px the slits
  stop resolving and the mark degrades into a plain, correct microphone, which is the
  right failure: the second reading is a reward for looking, not what carries the first.

  The slits are holes cut with evenOdd, not bars painted in the background colour. The
  themed layer (ic_launcher_monochrome) is re-tinted to one flat colour by the system, so
  a painted slit would fill in and vanish there while looking correct here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The head, with the meter cut out of it. One path: the capsule is the outer
         contour and the four slits are inner contours, so evenOdd makes them holes. -->
    <path
        android:fillColor="#BFA789"
        android:fillType="evenOdd"
        android:pathData="M43,38 a11,11 0 0 1 22,0 v12 a11,11 0 0 1 -22,0 z
                          M45.75,39.5 a1.5,1.5 0 0 1 3,0 v9 a1.5,1.5 0 0 1 -3,0 z
                          M50.25,35.5 a1.5,1.5 0 0 1 3,0 v17 a1.5,1.5 0 0 1 -3,0 z
                          M54.75,37.5 a1.5,1.5 0 0 1 3,0 v13 a1.5,1.5 0 0 1 -3,0 z
                          M59.25,41 a1.5,1.5 0 0 1 3,0 v6 a1.5,1.5 0 0 1 -3,0 z" />

    <!-- The cradle: the half-ring the head hangs in. This is the shape that reads as a
         microphone at 48px, when the slits and the stem no longer resolve. -->
    <path
        android:strokeColor="#BFA789"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M70,52 A16,16 0 0 1 38,52" />

    <!-- The stem: 3.6dp wide, meeting the cradle at its lowest point and standing clear
         of the foot rather than sinking into it. -->
    <path
        android:fillColor="#BFA789"
        android:pathData="M52.2,68 h3.6 v10 h-3.6 z" />

    <!-- The foot. -->
    <path
        android:fillColor="#BFA789"
        android:pathData="M44.7,78 h18.6 a1.7,1.7 0 0 1 0,3.4 h-18.6 a1.7,1.7 0 0 1 0,-3.4 z" />
</vector>
