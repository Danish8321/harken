<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a plain microphone — capsule, stem, base — nothing else.

  v1 (ARC-001) drew the same capsule/stem/base at 18dp wide inside a 68x56dp safe zone,
  plus four extra tick/bar shapes flanking it meant to read as a level meter. On a real
  home screen (Nothing OS) the whole thing read as a faint grey smear: the launcher's own
  icon inset shrinks the foreground further than a desktop vector preview shows, and a
  glyph occupying a quarter of the available width has nothing left after that.

  v2 tried fixing that by enlarging three shapes (capsule + two flanking bars) to equal
  weight — which stopped reading as a mic at all and became three abstract blobs.

  v3 drops the meter conceit for good and keeps exactly one glyph — mic capsule, stem,
  base — but sized to use the same proven-safe 68x56dp zone (x 20..88, y 26..82) that
  ARC-001 already confirmed survives the round mask, rather than a small glyph centred
  inside it. Width triples (18dp -> 28dp capsule, 44dp base) without changing the
  silhouette, so it is unambiguously a microphone at both desktop and launcher scale.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The capsule: the mic's head. -->
    <path
        android:fillColor="#BFA789"
        android:pathData="M40,40 a14,14 0 0 1 28,0 v18 a14,14 0 0 1 -28,0 z" />

    <!-- The stem: connects the head to the base. -->
    <path
        android:fillColor="#BFA789"
        android:pathData="M48,72 h12 v6 h-12 z" />

    <!-- The base: what the mic stands on. -->
    <path
        android:fillColor="#BFA789"
        android:pathData="M36,74 h36 a4,4 0 0 1 0,8 h-36 a4,4 0 0 1 0,-8 z" />
</vector>
